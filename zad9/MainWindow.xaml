
<Window x:Class="zadanie9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz" Height="400" Width="500">

    <StackPanel Margin="30">

        <TextBlock x:Name="pytanie"
                   FontSize="22"
                   TextWrapping="Wrap"
                   Margin="5"/>

        <RadioButton x:Name="odpA" GroupName="odpowiedzi" Margin="5"/>
        <RadioButton x:Name="odpB" GroupName="odpowiedzi" Margin="5"/>
        <RadioButton x:Name="odpC" GroupName="odpowiedzi" Margin="5"/>
        <RadioButton x:Name="odpD" GroupName="odpowiedzi" Margin="5"/>

        <Button Content="Następne"
                Height="40"
                Margin="5"
                Click="Nastepne_Click"/>

        <TextBlock x:Name="wynik"
                   FontSize="20"
                   Margin="5"/>

    </StackPanel>

</Window>
