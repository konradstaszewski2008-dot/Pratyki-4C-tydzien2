<Window x:Class="zadanie8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zadanie8"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid>
        <StackPanel Margin="20">

                <TextBox x:Name="imie" Margin="5" Height="30"/>
                <TextBox x:Name="telefon" Margin="5" Height="30"/>
                <TextBox x:Name="email" Margin="5" Height="30"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Dodaj" Click="Dodaj_Click"
                    Margin="5" Width="100"/>

                    <Button Content="Edytuj" Click="Edytuj_Click"
                    Margin="5" Width="100"/>

                    <Button Content="Usuń" Click="Usun_Click"
                    Margin="5" Width="100"/>
                </StackPanel>

                <DataGrid x:Name="tabela"
                  AutoGenerateColumns="True"
                  Height="250"
                  Margin="5"
                  SelectionChanged="tabela_SelectionChanged"/>

            </StackPanel>

    </Grid>
</Window>
