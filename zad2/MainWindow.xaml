<Window x:Class="zadanie2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zadanie2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="500">
   
            <Grid>
                <StackPanel Margin="20">

            <TextBox x:Name="poleZadania" Height="40" FontSize="18" Margin="0,0,0,10"/>
                    
            <Button Content="Dodaj zadanie" Height="40" Margin="0,0,0,10" Click="Dodaj_Click"/>
                    
            <ListBox x:Name="listaZadan"  Height="220" FontSize="18" Margin="0,0,0,10"/>
                    
            <Button Content="Usuń zaznaczone" Height="40" Click="Usun_Click"/>
        </StackPanel>
            </Grid>

        </Window>

