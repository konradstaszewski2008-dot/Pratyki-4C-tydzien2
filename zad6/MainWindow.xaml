
<Window x:Class="zadanie6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zadanie6"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <StackPanel Margin="20">

            <Button Content="Wybierz folder"
                Width="150"
                Height="35"
                HorizontalAlignment="Left"
                Click="WybierzFolder_Click"
                Margin="0,0,0,15"/>

            <ListBox x:Name="listaObrazow"
                 Height="120"
                 SelectionChanged="ListaObrazow_SelectionChanged">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Image Source="{Binding}"
                           Width="100"
                           Height="100"
                           Stretch="Uniform"
                           Margin="5"/>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <TextBlock Text="Podgląd:"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,20,0,10"/>

            <Image x:Name="duzyObraz"
               Height="350"
               Stretch="Uniform"/>

        </StackPanel>

    </Grid>
</Window>
