<Window x:Class="zadanie4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zadanie4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

            <StackPanel Margin="30">

                <TextBlock Text="Imię"/>
                <TextBox x:Name="imie" Margin="5"/>

                <TextBlock Text="Nazwisko"/>
                <TextBox x:Name="nazwisko" Margin="5"/>

                <TextBlock Text="E-mail"/>
                <TextBox x:Name="email" Margin="5"/>

                <TextBlock Text="Hasło"/>
                <PasswordBox x:Name="haslo" Margin="5"/>

                <TextBlock Text="Potwierdź hasło"/>
                <PasswordBox x:Name="haslo2" Margin="5"/>

                <CheckBox x:Name="regulamin"
                  Content="Akceptuję regulamin"
                  Margin="5"/>

                <Button Content="Zarejestruj"
                Margin="5"
                Height="35"
                Click="Zarejestruj_Click"/>

                <TextBlock x:Name="komunikat"
                   Foreground="Red"
                   Margin="5"/>

            </StackPanel>

     

    </Grid>
</Window>
